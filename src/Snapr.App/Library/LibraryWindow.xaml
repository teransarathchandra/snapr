<Window x:Class="Snapr.App.Library.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Library" Style="{StaticResource SnaprWindow}" Width="1000" Height="700"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="ChipButton" TargetType="ToggleButton">
      <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentFillBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0">
      <Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click"/>
      <ComboBox x:Name="KindBox" DockPanel.Dock="Right" Width="130" Margin="8,0,0,0" SelectedIndex="0"
                SelectionChanged="Kind_SelectionChanged" AutomationProperties.Name="Kind">
        <ComboBoxItem Content="All"/>
        <ComboBoxItem Content="Images"/>
        <ComboBoxItem Content="Videos"/>
        <ComboBoxItem Content="Region"/>
        <ComboBoxItem Content="Window"/>
        <ComboBoxItem Content="Full screen"/>
        <ComboBoxItem Content="Scrolling"/>
        <ComboBoxItem Content="Panoramic"/>
        <ComboBoxItem Content="Clipboard"/>
        <ComboBoxItem Content="Imported"/>
      </ComboBox>
      <Grid>
        <TextBox x:Name="SearchBox" TextChanged="Search_TextChanged" AutomationProperties.Name="Search"/>
        <TextBlock Text="Search names, window titles and tags" Foreground="{StaticResource TextSecondaryBrush}"
                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="9,0,0,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </DockPanel>

    <WrapPanel x:Name="TagChips" Grid.Row="1" Margin="0,8,0,0"/>

    <DockPanel Grid.Row="2" Margin="0,8,0,0">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <Button x:Name="OpenButton" Content="Open" Click="Open_Click"/>
        <Button x:Name="TagsButton" Content="Tags…" Click="Tags_Click"/>
        <Button x:Name="TemplateButton" Content="Template…" Click="Template_Click"/>
        <Button x:Name="FolderButton" Content="Show in folder" Click="Folder_Click"/>
        <Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click"/>
      </StackPanel>
      <TextBlock x:Name="Status" HorizontalAlignment="Right" VerticalAlignment="Center"
                 Foreground="{StaticResource TextSecondaryBrush}"/>
    </DockPanel>

    <ListBox x:Name="Tiles" Grid.Row="3" Margin="0,8,0,0" SelectionMode="Extended"
             Background="{StaticResource PanelBrush}" BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             SelectionChanged="Tiles_SelectionChanged" MouseDoubleClick="Tiles_DoubleClick"
             KeyDown="Tiles_KeyDown" AutomationProperties.Name="Captures">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel/>
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.GroupStyle>
        <GroupStyle>
          <GroupStyle.HeaderTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeader}" Margin="8,12,0,4"/>
            </DataTemplate>
          </GroupStyle.HeaderTemplate>
        </GroupStyle>
      </ListBox.GroupStyle>
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
          <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
          <Setter Property="Padding" Value="4"/>
          <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" Padding="{TemplateBinding Padding}">
                  <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlBrush}"/></Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentFillBrush}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentFillBrush}"/>
                  </Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextBrush}"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
          <Setter Property="ContextMenu">
            <Setter.Value>
              <ContextMenu Opened="Menu_Opened">
                <MenuItem Header="Open" Click="Open_Click"/>
                <MenuItem Header="Tags…" Click="Tags_Click"/>
                <MenuItem Header="Template…" Click="Template_Click"/>
                <MenuItem Header="Show in folder" Click="Folder_Click"/>
                <MenuItem Header="Delete" Click="Delete_Click"/>
              </ContextMenu>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Width="170">
            <Border Width="160" Height="100" Background="{StaticResource CanvasBrush}">
              <Grid>
                <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                <TextBlock Text="▶" FontSize="28" Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVideo}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="Couldn't read" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Unreadable}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </Border>
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip="{Binding Name}"/>
            <TextBlock Text="{Binding TagsText}" FontSize="11" TextTrimming="CharacterEllipsis">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</Window>
