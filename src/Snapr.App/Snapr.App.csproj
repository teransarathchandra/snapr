<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.18362.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF owns DPI awareness through the manifest; the WinForms analyzer rule does not apply. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>Snapr</AssemblyName>
    <RootNamespace>Snapr.App</RootNamespace>
    <Product>Snapr</Product>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms is used only for NotifyIcon and Screen; keep its namespaces out of the global usings to avoid WPF name clashes. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <ProjectReference Include="..\Snapr.Core\Snapr.Core.csproj" />
  </ItemGroup>
</Project>
