<Window x:Class="Snapr.App.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ed="clr-namespace:Snapr.App.Editor"
        Title="Snapr" Width="1280" Height="820" MinWidth="900" MinHeight="560"
        Style="{StaticResource SnaprWindow}" WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
  <DockPanel>
    <Border DockPanel.Dock="Top" Height="48" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1">
      <DockPanel Margin="12,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image x:Name="LogoImage" Width="20" Height="20" Margin="0,0,8,0"/>
          <TextBlock Text="Snapr" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
          <TextBlock x:Name="TitleText" Margin="12,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                     VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="UndoButton" Content="Undo" ToolTip="Undo (Ctrl+Z)" Click="Undo_Click"/>
          <Button x:Name="RedoButton" Content="Redo" ToolTip="Redo (Ctrl+Y)" Click="Redo_Click"/>
          <Button Content="Grab Text" ToolTip="Copy the text in the selected object's area, or the whole image" Click="GrabText_Click"/>
          <Button x:Name="LibraryButton" Content="Library" ToolTip="Browse, search and tag all captures (Ctrl+L)" Click="Library_Click"/>
          <Button x:Name="RedactButton" Content="Redact…" ToolTip="Find and cover emails, web addresses, card numbers, phone numbers or words you choose" Click="Redact_Click"/>
          <Button Content="Copy" ToolTip="Copy image (Ctrl+C copies the selected object)" Click="Copy_Click"/>
          <Button Content="Save" ToolTip="Save as image (Ctrl+Shift+S)" Style="{StaticResource AccentButton}" Click="Save_Click"/>
          <Button x:Name="ImageButton" Content="Image ▾" ToolTip="Rotate, flip, resize or add margins to the image" Click="ImageMenu_Click">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Rotate right" Click="RotateRight_Click"/>
                <MenuItem Header="Rotate left" Click="RotateLeft_Click"/>
                <MenuItem Header="Rotate 180°" Click="Rotate180_Click"/>
                <MenuItem Header="Flip horizontal" Click="FlipHorizontal_Click"/>
                <MenuItem Header="Flip vertical" Click="FlipVertical_Click"/>
                <Separator/>
                <MenuItem Header="Resize image…" Click="ResizeImage_Click"/>
                <MenuItem Header="Canvas size…" Click="CanvasSize_Click"/>
                <MenuItem Header="Simplify…" Click="Simplify_Click"/>
                <Separator/>
                <MenuItem x:Name="RevertImageItem" Header="Revert to original image" Click="RevertImage_Click"/>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button x:Name="ExportButton" Content="Export ▾" Click="Export_Click">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="PNG image…" Click="ExportPng_Click"/>
                <MenuItem Header="JPG image…" Click="ExportJpg_Click"/>
                <MenuItem Header="GIF image…" Click="ExportGif_Click"/>
                <MenuItem Header="BMP image…" Click="ExportBmp_Click"/>
                <MenuItem Header="PDF document…" Click="ExportPdf_Click"/>
                <MenuItem Header="Snapr file (.snapr)…" Click="ExportSnapr_Click"/>
                <Separator/>
                <MenuItem Header="Print…" InputGestureText="Ctrl+P" Click="PrintFit_Click"/>
                <MenuItem Header="Print actual size…" Click="PrintActual_Click"/>
                <Separator/>
                <MenuItem Header="Show in folder" Click="ShowInFolder_Click"/>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Height="96" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="RecentsList" Margin="8,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <Border DockPanel.Dock="Left" Width="48" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,1,0">
      <StackPanel x:Name="ToolPanel" Margin="0,8"/>
    </Border>

    <Border DockPanel.Dock="Right" Width="240" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1,0,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="PropsPanel" Margin="16,0,16,16"/>
      </ScrollViewer>
    </Border>

    <Grid Background="{StaticResource CanvasBrush}">
      <ScrollViewer x:Name="CanvasScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
        <Border x:Name="CanvasFrame" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
          <ed:EditorCanvas x:Name="Board"/>
        </Border>
      </ScrollViewer>
      <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                 Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" LineHeight="22"
                 Text="No capture yet.&#10;Press Print Screen, or use Open image… in the tray menu."/>
      <Border x:Name="SaveBanner" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center"
              Margin="0,12" Background="#7F1D1D" CornerRadius="6" Padding="12,6">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="SaveBannerText" Text="Not saved" Foreground="White" VerticalAlignment="Center" MaxWidth="520" TextTrimming="CharacterEllipsis"/>
          <Button Content="Retry" Margin="12,0,0,0" Click="RetrySave_Click"/>
        </StackPanel>
      </Border>
      <Border x:Name="InfoBanner" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center"
              Margin="0,56,0,0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
              BorderThickness="1" CornerRadius="6" Padding="12,6">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="InfoBannerText" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" MaxWidth="640" TextWrapping="Wrap"/>
          <Button Content="Dismiss" Margin="12,0,0,0" Click="DismissNotice_Click"/>
        </StackPanel>
      </Border>
      <Button x:Name="ZoomButton" Content="Fit" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12"
              ToolTip="Switch between fit-to-window and actual pixels" Click="Zoom_Click"/>
    </Grid>
  </DockPanel>
</Window>
