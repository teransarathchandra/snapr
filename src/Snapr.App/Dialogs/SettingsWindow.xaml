<Window x:Class="Snapr.App.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapr Settings" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        Style="{StaticResource SnaprWindow}" WindowStartupLocation="CenterScreen">
  <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,12,24,24">
      <Button Content="Cancel" IsCancel="True"/>
      <Button Content="Save" IsDefault="True" Style="{StaticResource AccentButton}" Click="Save_Click"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,8,24,12">
    <TextBlock Text="HOTKEYS" Style="{StaticResource SectionHeader}"/>
    <TextBlock Text="Click a box and press the new key combination. Backspace clears it (no hotkey)." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
      <TextBlock Text="Capture image" VerticalAlignment="Center"/>
      <TextBox x:Name="ImageHotkey" Grid.Column="1" Margin="0,4" IsReadOnly="True" PreviewKeyDown="Hotkey_KeyDown"/>
      <TextBlock Grid.Row="1" Text="Record video" VerticalAlignment="Center"/>
      <TextBox x:Name="VideoHotkey" Grid.Row="1" Grid.Column="1" Margin="0,4" IsReadOnly="True" PreviewKeyDown="Hotkey_KeyDown"/>
      <TextBlock Grid.Row="2" Text="Scrolling capture" VerticalAlignment="Center"/>
      <TextBox x:Name="ScrollHotkey" Grid.Row="2" Grid.Column="1" Margin="0,4" IsReadOnly="True" PreviewKeyDown="Hotkey_KeyDown"/>
      <TextBlock Grid.Row="3" Text="Repeat last capture" VerticalAlignment="Center"/>
      <TextBox x:Name="RepeatHotkey" Grid.Row="3" Grid.Column="1" Margin="0,4" IsReadOnly="True" PreviewKeyDown="Hotkey_KeyDown"/>
      <TextBlock Grid.Row="4" Text="Start/pause video" VerticalAlignment="Center"/>
      <TextBox x:Name="PauseHotkey" Grid.Row="4" Grid.Column="1" Margin="0,4" IsReadOnly="True" PreviewKeyDown="Hotkey_KeyDown"/>
      <TextBlock Grid.Row="5" Text="Panoramic capture" VerticalAlignment="Center"/>
      <TextBox x:Name="PanoHotkey" Grid.Row="5" Grid.Column="1" Margin="0,4" IsReadOnly="True" PreviewKeyDown="Hotkey_KeyDown"/>
    </Grid>

    <TextBlock Text="CAPTURE" Style="{StaticResource SectionHeader}"/>
    <DockPanel Margin="0,4">
      <TextBlock x:Name="DelayValue" DockPanel.Dock="Right" Width="40" TextAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}"/>
      <TextBlock Text="Delay before capture" Width="160" VerticalAlignment="Center"/>
      <Slider x:Name="DelaySlider" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Delay_Changed"/>
    </DockPanel>
    <CheckBox x:Name="CursorCheck" Content="Include the mouse pointer in captures"/>

    <TextBlock Text="SAVE" Style="{StaticResource SectionHeader}"/>
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="Save button format" Width="160" VerticalAlignment="Center"/>
      <RadioButton x:Name="PngRadio" Content="PNG" GroupName="format"/>
      <RadioButton x:Name="JpgRadio" Content="JPG" GroupName="format"/>
    </StackPanel>
    <DockPanel Margin="0,4">
      <TextBlock x:Name="QualityValue" DockPanel.Dock="Right" Width="40" TextAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}"/>
      <TextBlock Text="JPG quality" Width="160" VerticalAlignment="Center"/>
      <Slider x:Name="QualitySlider" Minimum="50" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Quality_Changed"/>
    </DockPanel>

    <TextBlock Text="VIDEO" Style="{StaticResource SectionHeader}"/>
    <TextBlock Text="ffmpeg.exe (not included with Snapr)" Margin="0,0,0,4"/>
    <DockPanel>
      <Button Content="Browse…" DockPanel.Dock="Right" Margin="6,0,0,0" Click="BrowseFfmpeg_Click"/>
      <Button Content="Detect" DockPanel.Dock="Right" Margin="6,0,0,0" Click="DetectFfmpeg_Click"/>
      <TextBox x:Name="FfmpegBox"/>
    </DockPanel>
    <TextBlock x:Name="FfmpegStatus" FontSize="11" Margin="0,4,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
    <CheckBox x:Name="SystemAudioCheck" Content="Record system audio"/>
    <CheckBox x:Name="MicCheck" Content="Record microphone"/>
    <ComboBox x:Name="MicCombo" DisplayMemberPath="Name" Margin="24,4,0,0"/>

    <TextBlock Text="WEBCAM" Style="{StaticResource SectionHeader}"/>
    <CheckBox x:Name="WebcamCheck" Content="Show webcam while recording" Checked="WebcamCheck_Changed" Unchecked="WebcamCheck_Changed"/>
    <StackPanel x:Name="WebcamRows" Margin="24,4,0,0">
      <ComboBox x:Name="CameraCombo" DisplayMemberPath="Name"/>
      <StackPanel Orientation="Horizontal" Margin="0,4">
        <TextBlock Text="Shape" Width="60" VerticalAlignment="Center"/>
        <ComboBox x:Name="ShapeCombo" Width="160"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,4">
        <TextBlock Text="Size" Width="60" VerticalAlignment="Center"/>
        <ComboBox x:Name="SizeCombo" Width="160"/>
      </StackPanel>
      <CheckBox x:Name="MirrorCheck" Content="Mirror"/>
    </StackPanel>

    <TextBlock Text="PRESETS" Style="{StaticResource SectionHeader}"/>
    <ListBox x:Name="PresetList" Height="120" DisplayMemberPath="Summary" SelectionChanged="PresetList_SelectionChanged"/>
    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
      <Button x:Name="AddPreset" Content="Add…" Click="AddPreset_Click"/>
      <Button x:Name="EditPreset" Content="Edit…" Margin="6,0,0,0" Click="EditPreset_Click"/>
      <Button x:Name="DeletePreset" Content="Delete" Margin="6,0,0,0" Click="DeletePreset_Click"/>
      <Button x:Name="RunPreset" Content="Run" Margin="6,0,0,0" Click="RunPreset_Click"/>
    </StackPanel>
    </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
